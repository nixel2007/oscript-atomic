#Использовать "../internal"

Перем Значение; // Текущее значение ссылки
Перем Блокировка; // Блокировка для изменения значения

// Получает текущее значение ссылки
// 
// Возвращаемое значение:
//   Произвольный - текущее значение
// 
Функция Получить() Экспорт

	Блокировка.Заблокировать();
	Результат = Значение;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Устанавливает новое значение ссылки
// 
// Параметры:
//   НовоеЗначение - Произвольное - новое значение для установки
Процедура Установить(Знач НовоеЗначение) Экспорт

	Блокировка.Заблокировать();
	Значение = НовоеЗначение;
	Блокировка.Разблокировать();

КонецПроцедуры

// Получает текущее значение и устанавливает новое
// Атомарная операция: получение текущего и установка нового значения происходит неделимо
// 
// Параметры:
//   НовоеЗначение - Произвольное - новое значение для установки
// 
// Возвращаемое значение:
//   Произвольное - предыдущее значение
// 
Функция ПолучитьИУстановить(Знач НовоеЗначение) Экспорт

	Блокировка.Заблокировать();
	Результат = Получить();
	Установить(НовоеЗначение);
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Сравнивает текущее значение с ожидаемым и при равенстве устанавливает новое
// 
// Параметры:
//   ОжидаемоеЗначение - Произвольное - значение, с которым сравнивается текущее
//   НовоеЗначение - Произвольное - значение для установки при совпадении
// 
// Возвращаемое значение:
//   Булево - Истина если значение было установлено, Ложь если текущее значение не совпало с ожидаемым
// 
Функция СравнитьИУстановить(Знач ОжидаемоеЗначение, Знач НовоеЗначение) Экспорт

	Блокировка.Заблокировать();

	Результат = Получить() = ОжидаемоеЗначение;

	Если Результат Тогда
		Установить(НовоеЗначение);
	КонецЕсли;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Получает текущее значение и обновляет его с помощью функции
// 
// Параметры:
//   ФункцияОбновления - Действие - Делегат на функцию с одним параметром, в который передаётся
//     текущее значение ссылки
//   - Строка - Лямбда-выражение с одним параметром, в который передаётся текущее значение ссылки
//   Контекст - Структура - Контекст, добавляемый в лямбда-выражение, значения будут доступны
//     по обращению к ключу как к переменной. При передаче действия во втором параметре
//     этот параметр игнорируется
//   - Сценарий - Экземпляр объекта, который будет захвачен в лямбда-выражение,
//     в лямбда-выражении будет доступен контекст (публичные и приватные поля, публичные методы)
//     объекта. При передаче действия во втором параметре этот параметр игнорируется
// 
// Возвращаемое значение:
//   Произвольное - предыдущее значение ссылки
// 
// Примеры:
// 
// АтомарнаяСсылка.ПолучитьИОбновить("Значение -> Значение * 2")
//
// АтомарнаяСсылка.ПолучитьИОбновить("Значение -> Значение * Множитель",
//     Новый Структура("Множитель", 3))
//
// АтомарнаяСсылка.ПолучитьИОбновить(Новый Действие(ЭтотОбъект, "УмножитьНа2"))
//
Функция ПолучитьИОбновить(Знач ФункцияОбновления, Знач Контекст = Неопределено) Экспорт

	ФункцияОбновления = АтомарныеСлужебный.ДействиеИзПараметров(
		ФункцияОбновления,
		ФункциональныеИнтерфейсы.УниФункция(),
		Контекст
	);

	Блокировка.Заблокировать();

	Результат = Получить();

	Попытка
		Установить(ФункцияОбновления.Выполнить(Результат));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Обновляет значение ссылки и возвращает новое значение
// 
// Параметры:
//   ФункцияОбновления - Действие - Делегат на функцию с одним параметром, в который передаётся
//     текущее значение ссылки
//   - Строка - Лямбда-выражение с одним параметром, в который передаётся текущее значение ссылки
//   Контекст - Структура - Контекст, добавляемый в лямбда-выражение, значения будут доступны
//     по обращению к ключу как к переменной. При передаче действия во втором параметре
//     этот параметр игнорируется
//   - Сценарий - Экземпляр объекта, который будет захвачен в лямбда-выражение,
//     в лямбда-выражении будет доступен контекст (публичные и приватные поля, публичные методы)
//     объекта. При передаче действия во втором параметре этот параметр игнорируется
// 
// Возвращаемое значение:
//   Произвольное - новое значение ссылки
// 
// Примеры:
// 
// АтомарнаяСсылка.ОбновитьИПолучить("Значение -> ВРег(Значение)")
// 
// АтомарнаяСсылка.ОбновитьИПолучить("Значение -> Значение + Префикс",
//     Новый Структура("Префикс", "_"))
// 
// АтомарнаяСсылка.ОбновитьИПолучить(Новый Действие(ЭтотОбъект, "Преобразовать"))
//
Функция ОбновитьИПолучить(Знач ФункцияОбновления, Знач Контекст = Неопределено) Экспорт

	ФункцияОбновления = АтомарныеСлужебный.ДействиеИзПараметров(
		ФункцияОбновления,
		ФункциональныеИнтерфейсы.УниФункция(),
		Контекст
	);

	Блокировка.Заблокировать();

	Попытка
		Установить(ФункцияОбновления.Выполнить(Получить()));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Получить();

КонецФункции

// Получает текущее значение, применяет бинарную функцию с аргументом и устанавливает результат
// 
// Параметры:
//   Аргумент - Произвольный - аргумент для бинарной функции
//   ФункцияСложения - Действие - Делегат на функцию с двумя параметрами, в которые передаются
//     текущее значение ссылки и аргумент
//   - Строка - Лямбда-выражение с двумя параметрами, в которые передаются
//     текущее значение ссылки и аргумент
//   Контекст - Структура - Контекст, добавляемый в лямбда-выражение, значения будут доступны
//     по обращению к ключу как к переменной. При передаче действия в третьем параметре
//     этот параметр игнорируется
//   - Сценарий - Экземпляр объекта, который будет захвачен в лямбда-выражение,
//     в лямбда-выражении будет доступен контекст (публичные и приватные поля, публичные методы)
//     объекта. При передаче действия в третьем параметре этот параметр игнорируется
// 
// Возвращаемое значение:
//   Произвольное - предыдущее значение ссылки
// 
// Примеры:
// 
// АтомарнаяСсылка.ПолучитьИСложить(10, "(Текущее, Аргумент) -> Текущее + Аргумент")
//
// АтомарнаяСсылка.ПолучитьИСложить(5, "(Текущее, Аргумент) -> Текущее + Аргумент * Коэффициент",
//     Новый Структура("Коэффициент", 2))
//
// АтомарнаяСсылка.ПолучитьИСложить(3, Новый Действие(ЭтотОбъект, "Сложить"))
//
Функция ПолучитьИСложить(Знач Аргумент, Знач ФункцияСложения, Знач Контекст = Неопределено) Экспорт

	ФункцияСложения = АтомарныеСлужебный.ДействиеИзПараметров(
		ФункцияСложения,
		ФункциональныеИнтерфейсы.БиФункция(),
		Контекст
	);

	Блокировка.Заблокировать();

	Результат = Получить();

	Попытка
		Установить(ФункцияСложения.Выполнить(Получить(), Аргумент));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Применяет бинарную функцию к текущему значению и аргументу, возвращает результат
// 
// Параметры:
//   Аргумент - Произвольный - аргумент для бинарной функции
//   ФункцияСложения - Действие - Делегат на функцию с двумя параметрами, в которые передаются
//     текущее значение ссылки и аргумент
//   - Строка - Лямбда-выражение с двумя параметрами, в которые передаются
//     текущее значение ссылки и аргумент
//   Контекст - Структура - Контекст, добавляемый в лямбда-выражение, значения будут доступны
//     по обращению к ключу как к переменной. При передаче действия в третьем параметре
//     этот параметр игнорируется
//   - Сценарий - Экземпляр объекта, который будет захвачен в лямбда-выражение,
//     в лямбда-выражении будет доступен контекст (публичные и приватные поля, публичные методы)
//     объекта. При передаче действия в третьем параметре этот параметр игнорируется
// 
// Возвращаемое значение:
//   Произвольное - новое значение ссылки
// 
// Примеры:
// 
// АтомарнаяСсылка.СложитьИПолучить("b", "(Текущее, Аргумент) -> Текущее + Аргумент")
//
// АтомарнаяСсылка.СложитьИПолучить(7, "(Текущее, Аргумент) -> Текущее + Аргумент + Сдвиг",
//     Новый Структура("Сдвиг", 1))
//
// АтомарнаяСсылка.СложитьИПолучить(2, Новый Действие(ЭтотОбъект, "Прибавить"))
//
Функция СложитьИПолучить(Знач Аргумент, Знач ФункцияСложения, Знач Контекст = Неопределено) Экспорт

	ФункцияСложения = АтомарныеСлужебный.ДействиеИзПараметров(
		ФункцияСложения,
		ФункциональныеИнтерфейсы.БиФункция(),
		Контекст
	);

	Блокировка.Заблокировать();

	Попытка
		Установить(ФункцияСложения.Выполнить(Получить(), Аргумент));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Получить();

КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	СтандартнаяОбработка = Ложь;
	Представление        = Строка(Получить());
КонецПроцедуры

Процедура ПриСозданииОбъекта(НачальноеЗначение = Неопределено)
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	Установить(НачальноеЗначение);
КонецПроцедуры