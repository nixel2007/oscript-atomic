#Использовать "../internal"

Перем Значение; // Текущее значение
Перем Блокировка; // Блокировка для изменения значения

// Получает текущее значение атомарного числа
//
// Возвращаемое значение:
//   Число - текущее значение
//
Функция Получить() Экспорт

	Блокировка.Заблокировать();
	Результат = Значение;
	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Устанавливает новое значение атомарного числа
//
// Параметры:
//   НовоеЗначение - Число - новое значение
//
// Возвращаемое значение:
//   Число - предыдущее значение
//
Процедура Установить(Знач НовоеЗначение) Экспорт

	Если ТипЗнч(НовоеЗначение) <> Тип("Число") Тогда
		ВызватьИсключение "Устанавливаемое значение должно быть числом";
	КонецЕсли;

	Блокировка.Заблокировать();
	Значение = НовоеЗначение;
	Блокировка.Разблокировать();

КонецПроцедуры

// Получает текущее значение и устанавливает новое
//
// Параметры:
//   НовоеЗначение - Число - новое значение
//
// Возвращаемое значение:
//   Число - предыдущее значение
//
Функция ПолучитьИУстановить(Знач НовоеЗначение) Экспорт

	Блокировка.Заблокировать();
	Результат = Получить();

	Попытка
		Установить(НовоеЗначение);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Сравнивает текущее значение с ожидаемым и устанавливает новое при успехе
//
// Параметры:
//   ОжидаемоеЗначение - Число - ожидаемое значение
//   НовоеЗначение - Число - новое значение
//
// Возвращаемое значение:
//   Булево - Истина если обновление прошло успешно, Ложь иначе
//
Функция СравнитьИУстановить(Знач ОпимаемоеЗначение, Знач НовоеЗначение) Экспорт

	Блокировка.Заблокировать();

	Результат = Получить() = ОпимаемоеЗначение;

	Если Результат Тогда

		Попытка
			Установить(НовоеЗначение);
		Исключение
			Блокировка.Разблокировать();
			ВызватьИсключение;
		КонецПопытки;

	КонецЕсли;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Получает текущее значение и увеличивает его на 1
//
// Возвращаемое значение:
//   Число - предыдущее значение
//
Функция ПолучитьИИнкрементировать() Экспорт
	Возврат ПолучитьИДобавить(1);
КонецФункции

// Получает текущее значение и уменьшает его на 1
//
// Возвращаемое значение:
//   Число - предыдущее значение
//
Функция ПолучитьИДекрементировать() Экспорт
	Возврат ПолучитьИДобавить(-1);
КонецФункции

// Получает текущее значение и добавляет к нему указанное число
//
// Параметры:
//   ДобавляемоеЗначение - Число - значение для добавления
//
// Возвращаемое значение:
//   Число - предыдущее значение
//
Функция ПолучитьИДобавить(Знач ДобавляемоеЗначение) Экспорт

	Блокировка.Заблокировать();

	Результат = Получить();

	Попытка
		Установить(Результат + ДобавляемоеЗначение);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Получает текущее значение, применяет функцию и устанавливает результат
//
// Параметры:
//   ФункцияОбновления - Действие - Делегат на функцию с одним параметром, в который передаётся
//     текущее значение
//   - Строка - Лямбда-выражение с одним параметром, в который передаётся текущее значение
//   Контекст - Структура - Контекст, добавляемый в лямбда-выражение, значения будут доступны
//     по обращению к ключу как к переменной. При передаче действия во втором параметре
//     этот параметр игнорируется
//   - Сценарий - Экземпляр объекта, который будет захвачен в лямбда-выражение,
//     в лямбда-выражении будет доступен контекст (публичные и приватные поля, публичные методы)
//     объекта. При передаче действия во втором параметре этот параметр игнорируется
//
// Возвращаемое значение:
//   Число - предыдущее значение
//
// Примеры:
//
// АтомарноеЧисло.ПолучитьИОбновить("Значение -> Значение * 2")
//
// АтомарноеЧисло.ПолучитьИОбновить("Значение -> Значение * Множитель",
//     Новый Структура("Множитель", 5))
//
// АтомарноеЧисло.ПолучитьИОбновить(Новый Действие(ЭтотОбъект, "Умножить"))
//
Функция ПолучитьИОбновить(Знач ФункцияОбновления, Знач Контекст = Неопределено) Экспорт

	ФункцияОбновления = АтомарныеСлужебный.ДействиеИзПараметров(
		ФункцияОбновления,
		ФункциональныеИнтерфейсы.УниФункция(),
		Контекст
	);

	Блокировка.Заблокировать();

	Результат = Получить();

	Попытка
		Установить(ФункцияОбновления.Выполнить(Получить()));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Получает текущее значение, применяет бинарную функцию и устанавливает результат
//
// Параметры:
//   ДобавляемоеЗначение - Число - аргумент для бинарной функции
//   ФункцияСложения - Действие - Делегат на функцию с двумя параметрами, в которые передаются
//     текущее значение и аргумент
//   - Строка - Лямбда-выражение с двумя параметрами, в которые передаются
//     текущее значение и аргумент
//   Контекст - Структура - Контекст, добавляемый в лямбда-выражение, значения будут доступны
//     по обращению к ключу как к переменной. При передаче действия в третьем параметре
//     этот параметр игнорируется
//   - Сценарий - Экземпляр объекта, который будет захвачен в лямбда-выражение,
//     в лямбда-выражении будет доступен контекст (публичные и приватные поля, публичные методы)
//     объекта. При передаче действия в третьем параметре этот параметр игнорируется
//
// Возвращаемое значение:
//   Число - предыдущее значение
//
// Примеры:
//
// АтомарноеЧисло.ПолучитьИСложить(10, "(Текущее, Аргумент) -> Текущее + Аргумент")
//
// АтомарноеЧисло.ПолучитьИСложить(5, "(Текущее, Аргумент) -> Текущее + Аргумент * Коэффициент",
//     Новый Структура("Коэффициент", 2))
//
// АтомарноеЧисло.ПолучитьИСложить(3, Новый Действие(ЭтотОбъект, "Сложить"))
//
Функция ПолучитьИСложить(Знач ДобавляемоеЗначение, Знач ФункцияСложения, Знач Контекст = Неопределено) Экспорт

	ФункцияСложения = АтомарныеСлужебный.ДействиеИзПараметров(
		ФункцияСложения,
		ФункциональныеИнтерфейсы.БиФункция(),
		Контекст
	);

	Блокировка.Заблокировать();

	Результат = Получить();

	Попытка
		Установить(ФункцияСложения.Выполнить(Получить(), ДобавляемоеЗначение));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Результат;

КонецФункции

// Увеличивает значение на 1 и возвращает новое значение
//
// Возвращаемое значение:
//   Число - новое значение
//
Функция ИнкрементироватьИПолучить() Экспорт
	Возврат ДобавитьИПолучить(1);
КонецФункции

// Уменьшает значение на 1 и возвращает новое значение
//
// Возвращаемое значение:
//   Число - новое значение
//
Функция ДекрементироватьИПолучить() Экспорт
	Возврат ДобавитьИПолучить(-1);
КонецФункции

// Добавляет указанное значение к текущему и возвращает результат
//
// Параметры:
//   ДобавляемоеЗначение - Число - значение для добавления
//
// Возвращаемое значение:
//   Число - новое значение
//
Функция ДобавитьИПолучить(Знач ДобавляемоеЗначение) Экспорт

	Блокировка.Заблокировать();

	Попытка
		Установить(Получить() + ДобавляемоеЗначение);
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Получить();

КонецФункции

// Применяет функцию к текущему значению и возвращает результат
//
// Параметры:
//   ФункцияОбновления - Действие - Делегат на функцию с одним параметром, в который передаётся
//     текущее значение
//   - Строка - Лямбда-выражение с одним параметром, в который передаётся текущее значение
//   Контекст - Структура - Контекст, добавляемый в лямбда-выражение, значения будут доступны
//     по обращению к ключу как к переменной. При передаче действия во втором параметре
//     этот параметр игнорируется
//   - Сценарий - Экземпляр объекта, который будет захвачен в лямбда-выражение,
//     в лямбда-выражении будет доступен контекст (публичные и приватные поля, публичные методы)
//     объекта. При передаче действия во втором параметре этот параметр игнорируется
//
// Возвращаемое значение:
//   Число - новое значение
//
// Примеры:
//
// АтомарноеЧисло.ОбновитьИПолучить("Значение -> ВРег(Строка(Значение))")
//
// АтомарноеЧисло.ОбновитьИПолучить("Значение -> Значение + Слагаемое",
//     Новый Структура("Слагаемое", 10))
//
// АтомарноеЧисло.ОбновитьИПолучить(Новый Действие(ЭтотОбъект, "Умножить"))
//
Функция ОбновитьИПолучить(Знач ФункцияОбновления, Знач Контекст = Неопределено) Экспорт

	ФункцияОбновления = АтомарныеСлужебный.ДействиеИзПараметров(
		ФункцияОбновления,
		ФункциональныеИнтерфейсы.УниФункция(),
		Контекст
	);

	Блокировка.Заблокировать();

	Попытка
		Установить(ФункцияОбновления.Выполнить(Получить()));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Получить();

КонецФункции

// Применяет бинарную функцию к текущему значению и возвращает результат
//
// Параметры:
//   ДобавляемоеЗначение - Число - аргумент для бинарной функции
//   ФункцияСложения - Действие - Делегат на функцию с двумя параметрами, в которые передаются
//     текущее значение и аргумент
//   - Строка - Лямбда-выражение с двумя параметрами, в которые передаются
//     текущее значение и аргумент
//   Контекст - Структура - Контекст, добавляемый в лямбда-выражение, значения будут доступны
//     по обращению к ключу как к переменной. При передаче действия в третьем параметре
//     этот параметр игнорируется
//   - Сценарий - Экземпляр объекта, который будет захвачен в лямбда-выражение,
//     в лямбда-выражении будет доступен контекст (публичные и приватные поля, публичные методы)
//     объекта. При передаче действия в третьем параметре этот параметр игнорируется
//
// Возвращаемое значение:
//   Число - новое значение
//
// Примеры:
//
// АтомарноеЧисло.СложитьИПолучить(5, "(Текущее, Аргумент) -> Текущее + Аргумент")
//
// АтомарноеЧисло.СложитьИПолучить(2, "(Текущее, Аргумент) -> Текущее + Аргумент * Множитель",
//     Новый Структура("Множитель", 3))
//
// АтомарноеЧисло.СложитьИПолучить(10, Новый Действие(ЭтотОбъект, "Сложить"))
//
Функция СложитьИПолучить(Знач ДобавляемоеЗначение, Знач ФункцияСложения, Знач Контекст = Неопределено) Экспорт

	ФункцияСложения = АтомарныеСлужебный.ДействиеИзПараметров(
		ФункцияСложения,
		ФункциональныеИнтерфейсы.БиФункция(),
		Контекст
	);

	Блокировка.Заблокировать();

	Попытка
		Установить(ФункцияСложения.Выполнить(Получить(), ДобавляемоеЗначение));
	Исключение
		Блокировка.Разблокировать();
		ВызватьИсключение;
	КонецПопытки;

	Блокировка.Разблокировать();

	Возврат Получить();

КонецФункции

Процедура ОбработкаПолученияПредставления(Представление, СтандартнаяОбработка) // BSLLS:UnusedLocalMethod-off
	СтандартнаяОбработка = Ложь;
	Представление        = Строка(Получить());
КонецПроцедуры

Процедура ПриСозданииОбъекта(НачальноеЗначение = 0)
	Блокировка = Новый БлокировкаРесурса(ЭтотОбъект);
	Установить(НачальноеЗначение);
КонецПроцедуры