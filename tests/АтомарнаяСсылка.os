#Использовать asserts
#Использовать ".."
#Использовать "./Вспомогательные"

Перем Рефлектор; // Инстанс рефлектора

&Тест
Процедура Создается() Экспорт

	// Дано

	АтомарнаяСсылка = Новый АтомарнаяСсылка();

	// Тогда

	Ожидаем.Что(Рефлектор.ПолучитьСвойство(АтомарнаяСсылка, "Значение"))
		.Равно(Неопределено);

КонецПроцедуры

&Тест
Процедура СоздаетсяСНачальнымЗначением() Экспорт

	// Дано

	НачальноеЗначение = "ТестоваяСтрока";
	АтомарнаяСсылка = Новый АтомарнаяСсылка(НачальноеЗначение);

	// Тогда

	Ожидаем.Что(Рефлектор.ПолучитьСвойство(АтомарнаяСсылка, "Значение"))
		.Равно(НачальноеЗначение);

КонецПроцедуры

&Тест
Процедура Получить() Экспорт

	// Дано

	НачальноеЗначение = Новый Массив();
	АтомарнаяСсылка = Новый АтомарнаяСсылка(НачальноеЗначение);

	// Когда

	Результаты = Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарнаяСсылка,
		"Получить"
	);

	// Тогда

	Для Каждого Результат Из Результаты Цикл
		Ожидаем.Что(Результат).Равно(НачальноеЗначение);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Установить() Экспорт

	// Дано

	АтомарнаяСсылка = Новый АтомарнаяСсылка();
	НовоеЗначение = Новый Структура("Ключ", "Значение");

	// Когда

	Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарнаяСсылка,
		"Установить",
		НовоеЗначение
	);

	// Тогда

	Ожидаем.Что(АтомарнаяСсылка.Получить())
		.Равно(НовоеЗначение);

КонецПроцедуры

&Тест
Процедура ПолучитьИУстановить() Экспорт

	// Дано

	НачальноеЗначение = 0;
	АтомарнаяСсылка = Новый АтомарнаяСсылка(НачальноеЗначение);

	// Когда

	Результаты = Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарнаяСсылка,
		"ПолучитьИУстановить",
		"НовоеЗначение"
	);

	// Тогда

	Ожидаем.Что(АтомарнаяСсылка.Получить())
		.Равно("НовоеЗначение");

	КоличествоНачальных = 0;
	КоличествоНовых = 0;

	Для Каждого Результат Из Результаты Цикл
		Если Результат = НачальноеЗначение Тогда
			КоличествоНачальных = КоличествоНачальных + 1;
		ИначеЕсли Результат = "НовоеЗначение" Тогда
			КоличествоНовых = КоличествоНовых + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(КоличествоНачальных).Равно(1);
	Ожидаем.Что(КоличествоНовых).Равно(4);

КонецПроцедуры

&Тест
Процедура СравнитьИУстановить() Экспорт

	// Дано

	АтомарнаяСсылка = Новый АтомарнаяСсылка("Начальное");

	// Когда

	Результаты = Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарнаяСсылка,
		"СравнитьИУстановить",
		"Начальное",
		"Обновленное"
	);

	Успешных = 0;
	Неуспешных = 0;

	// Тогда

	Для Каждого Результат Из Результаты Цикл
		Если Результат Тогда
			Успешных = Успешных + 1;
		Иначе
			Неуспешных = Неуспешных + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Успешных).Равно(1);
	Ожидаем.Что(Неуспешных).Равно(4);
	Ожидаем.Что(АтомарнаяСсылка.Получить())
		.Равно("Обновленное");

КонецПроцедуры

&Тест
Процедура СравнитьИУстановитьНеУдача() Экспорт

	// Дано

	АтомарнаяСсылка = Новый АтомарнаяСсылка("Значение1");

	// Когда

	Результат = АтомарнаяСсылка.СравнитьИУстановить("НеверноеЗначение", "Значение2");

	// Тогда

	Ожидаем.Что(Результат).Равно(Ложь);
	Ожидаем.Что(АтомарнаяСсылка.Получить()).Равно("Значение1");

КонецПроцедуры

