&Тест
Процедура РаботаСОбъектом() Экспорт

	// Дано

	Объект = Новый Структура("Поле1", 1);
	АтомарнаяСсылка = Новый АтомарнаяСсылка(Объект);

	// Когда

	ПолученныйОбъект = АтомарнаяСсылка.Получить();

	// Тогда

	Ожидаем.Что(ПолученныйОбъект).Равно(Объект);
	Ожидаем.Что(ПолученныйОбъект.Поле1).Равно(1);

КонецПроцедуры

&Тест
Процедура ПолучитьИОбновитьИсключение() Экспорт

	// Дано

	АтомарнаяСсылка = Новый АтомарнаяСсылка(10);

	// Когда

	Попытка
		АтомарнаяСсылка.ПолучитьИОбновить(
			"Параметр -> 
			|Если Истина Тогда
			|    ВызватьИсключение ""Ошибка"";
			|    Возврат Неопределено;
			|КонецЕсли;"
		);
		Ожидаем.Что(Ложь).Равно(Истина); // Должно было быть исключение
	Исключение
		// Тогда - исключение прокинуто, значение не изменилось
		Ожидаем.Что(СтрНайти(ИнформацияОбОшибке().Описание, "Ошибка") > 0).Равно(Истина);
		Ожидаем.Что(АтомарнаяСсылка.Получить()).Равно(10);
	КонецПопытки;

КонецПроцедуры

