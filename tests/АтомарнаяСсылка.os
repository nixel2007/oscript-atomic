&Тест
Процедура ПолучитьИОбновитьСОбъектом() Экспорт

	// Дано - тестирует ветку ЛямбдаВыражение.ЗахватитьОбъект(ДополнительныеПараметры)

	АтомарнаяСсылка = Новый АтомарнаяСсылка(10);
	Контекст = Новый ТестовыйУмножитель();
	Контекст.Множитель = 7;

	// Когда

	Результат = АтомарнаяСсылка.ПолучитьИОбновить(
		"Значение -> Множитель * Значение",
		Контекст
	);

	// Тогда

	Ожидаем.Что(Результат).Равно(10);
	Ожидаем.Что(АтомарнаяСсылка.Получить()).Равно(70);

КонецПроцедуры

// Вспомогательные методы для тестов с Действие

Функция Удвоить(Значение) Экспорт
	Возврат Значение * 2;
КонецФункции

Функция ВЗаглавные(Строка) Экспорт
	Возврат ВРег(Строка);
КонецФункции

Функция Сложить(Текущее, Аргумент) Экспорт
	Возврат Текущее + Аргумент;
КонецФункции

Функция Умножить(Текущее, Аргумент) Экспорт
	Возврат Текущее * Аргумент;
КонецФункции

// Многопоточные тесты для проверки атомарности

&Тест
Процедура ПолучитьМногопоточно() Экспорт

	// Дано

	АтомарнаяСсылка = Новый АтомарнаяСсылка("test");

	// Когда

	Результаты = Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарнаяСсылка,
		"Получить"
	);

	// Тогда

	Для Каждого Результат Из Результаты Цикл
		Ожидаем.Что(Результат).Равно("test");
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура УстановитьМногопоточно() Экспорт

	// Дано

	АтомарнаяСсылка = Новый АтомарнаяСсылка("начальное");

	// Когда

	Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарнаяСсылка,
		"Установить",
		"измененное"
	);

	// Тогда

	Ожидаем.Что(АтомарнаяСсылка.Получить()).Равно("измененное");

КонецПроцедуры

&Тест
Процедура ПолучитьИУстановитьМногопоточно() Экспорт

	// Дано

	АтомарнаяСсылка = Новый АтомарнаяСсылка("original");

	// Когда

	Результаты = Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарнаяСсылка,
		"ПолучитьИУстановить",
		"updated"
	);

	// Тогда

	// Один поток должен был изменить значение, остальные получили "original"
	Ожидаем.Что(АтомарнаяСсылка.Получить()).Равно("updated");

	КоличествоОригиналов = 0;
	КоличествоОбновленных = 0;

	Для Каждого Результат Из Результаты Цикл
		Если Результат = "original" Тогда
			КоличествоОригиналов = КоличествоОригиналов + 1;
		ИначеЕсли Результат = "updated" Тогда
			КоличествоОбновленных = КоличествоОбновленных + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(КоличествоОригиналов).Равно(1);
	Ожидаем.Что(КоличествоОбновленных).Равно(4);

КонецПроцедуры

&Тест
Процедура СравнитьИУстановитьМногопоточно() Экспорт

	// Дано

	АтомарнаяСсылка = Новый АтомарнаяСсылка("value");

	// Когда

	Результаты = Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарнаяСсылка,
		"СравнитьИУстановить",
		"value",
		"new_value"
	);

	// Тогда

	// Только один поток должен успешно обновить значение
	Ожидаем.Что(АтомарнаяСсылка.Получить()).Равно("new_value");

	Успешных = 0;
	Неуспешных = 0;

	Для Каждого Результат Из Результаты Цикл
		Если Результат Тогда
			Успешных = Успешных + 1;
		Иначе
			Неуспешных = Неуспешных + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Успешных).Равно(1);
	Ожидаем.Что(Неуспешных).Равно(4);

КонецПроцедуры

Рефлектор = Новый Рефлектор();