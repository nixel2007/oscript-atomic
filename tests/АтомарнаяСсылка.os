	// Дано

	АтомарнаяСсылка = Новый АтомарнаяСсылка("hello");
	Обработчик = Новый ТестовыйСуффикс();
	Обработчик.Суффикс = "_world";
	ДействиеОбработки = Новый Действие(Обработчик, "Обработать");

	// Когда

	Результат = АтомарнаяСсылка.ОбновитьИПолучить(ДействиеОбработки);

	// Тогда

	Ожидаем.Что(Результат).Равно("hello_world");
	Ожидаем.Что(АтомарнаяСсылка.Получить()).Равно("hello_world");

КонецПроцедуры

// Тесты для покрытия веток ДействиеИзПараметров (АтомарныеСлужебный)

&Тест
Процедура ПолучитьИОбновитьСтруктурой() Экспорт

	// Дано - тестирует ветку ЛямбдаВыражение.Контекст(ДополнительныеПараметры)

	АтомарнаяСсылка = Новый АтомарнаяСсылка(10);

	// Когда

	Результат = АтомарнаяСсылка.ПолучитьИОбновить(
		"Значение -> Значение * Множитель",
		Новый Структура("Множитель", 5)
	);

	// Тогда

	Ожидаем.Что(Результат).Равно(10);
	Ожидаем.Что(АтомарнаяСсылка.Получить()).Равно(50);

КонецПроцедуры

&Тест
Процедура ОбновитьИПолучитьССтруктурой() Экспорт

	// Дано - тестирует ветку ЛямбдаВыражение.Контекст(ДополнительныеПараметры)

	АтомарнаяСсылка = Новый АтомарнаяСсылка("test");

	// Когда

	Результат = АтомарнаяСсылка.ОбновитьИПолучить(
		"Значение -> Значение + Префикс",
		Новый Структура("Префикс", "_suf")
	);

	// Тогда

	Ожидаем.Что(Результат).Равно("test_suf");
	Ожидаем.Что(АтомарнаяСсылка.Получить()).Равно("test_suf");

КонецПроцедуры

