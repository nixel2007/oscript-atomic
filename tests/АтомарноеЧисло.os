			"(Текущее, Аргумент) -> Неопределено" // Вернет Неопределено, Установить выбросит исключение
		);
		Ожидаем.Что(Ложь).Равно(Истина); // Должно было быть исключение
	Исключение
		// Тогда - исключение прокинуто, значение не изменилось
		Ожидаем.Что(АтомарноеЧисло.Получить()).Равно(5);
	КонецПопытки;

КонецПроцедуры

