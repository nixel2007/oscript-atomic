	// Когда

	Результат = АтомарноеЧисло.СравнитьИУстановить(999, 10);

	// Тогда

	Ожидаем.Что(Результат).Равно(Ложь);
	Ожидаем.Что(АтомарноеЧисло.Получить()).Равно(5);

