&Тест
Процедура Получить() Экспорт

	// Дано

	АтомарноеЧисло = Новый АтомарноеЧисло(5);

	// Когда

	Результаты = Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарноеЧисло,
		"Получить"
	);

	// Тогда

	Для Каждого Результат Из Результаты Цикл
		Ожидаем.Что(Результат).Равно(5);
	КонецЦикла;

КонецПроцедуры

&Тест
Процедура Установить() Экспорт

	// Дано

	АтомарноеЧисло = Новый АтомарноеЧисло();

	// Когда

	Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарноеЧисло,
		"Установить",
		10
	);

	// Тогда

	Ожидаем.Что(АтомарноеЧисло.Получить()).Равно(10);

КонецПроцедуры

&Тест
Процедура УстановитьНеЧисло() Экспорт

	// Дано

	АтомарноеЧисло = Новый АтомарноеЧисло();

	// Тогда

	Попытка
		АтомарноеЧисло.Установить("строка");
		Ожидаем.Что(Ложь, "Должно было быть выброшено исключение").Равно(Истина);
	Исключение
		Ожидаем.Что(ОписаниеОшибки()).Содержит("должно быть числом");
	КонецПопытки;

КонецПроцедуры

&Тест
Процедура ПолучитьИУстановить() Экспорт

	// Дано

	АтомарноеЧисло = Новый АтомарноеЧисло(5);

	// Когда

	Результаты = Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарноеЧисло,
		"ПолучитьИУстановить",
		100
	);

	// Тогда

	Ожидаем.Что(АтомарноеЧисло.Получить()).Равно(100);

	КоличествоПятерок = 0;
	КоличествоСотен = 0;

	Для Каждого Результат Из Результаты Цикл
		Если Результат = 5 Тогда
			КоличествоПятерок = КоличествоПятерок + 1;
		ИначеЕсли Результат = 100 Тогда
			КоличествоСотен = КоличествоСотен + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(КоличествоПятерок).Равно(1);
	Ожидаем.Что(КоличествоСотен).Равно(4);

КонецПроцедуры

&Тест
Процедура СравнитьИУстановить() Экспорт

	// Дано

	АтомарноеЧисло = Новый АтомарноеЧисло(10);

	// Когда

	Результаты = Вспомогательные.ВыполнитьВПятьПотоков(
		АтомарноеЧисло,
		"СравнитьИУстановить",
		10,
		20
	);

	Успешных = 0;
	Неуспешных = 0;

	// Тогда

	Для Каждого Результат Из Результаты Цикл
		Если Результат Тогда
			Успешных = Успешных + 1;
		Иначе
			Неуспешных = Неуспешных + 1;
		КонецЕсли;
	КонецЦикла;

	Ожидаем.Что(Успешных).Равно(1);
	Ожидаем.Что(Неуспешных).Равно(4);
	Ожидаем.Что(АтомарноеЧисло.Получить()).Равно(20);

КонецПроцедуры

