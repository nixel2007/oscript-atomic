&Тест
Процедура ПолучитьИОбновитьИсключение() Экспорт

	// Дано

	АтомарноеЧисло = Новый АтомарноеЧисло(5);

	// Когда

	Попытка
		АтомарноеЧисло.ПолучитьИОбновить(
			"Параметр -> ВызватьИсключение(""Ошибка"")"
		);
		Ожидаем.Что(Ложь).Равно(Истина); // Должно было быть исключение
	Исключение
		// Тогда - исключение прокинуто, значение не изменилось
		Ожидаем.Что(АтомарноеЧисло.Получить()).Равно(5);
	КонецПопытки;

КонецПроцедуры

